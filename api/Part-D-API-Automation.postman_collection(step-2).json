      "name": "GET - Get All Users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Get the response data\r\nconst users = pm.response.json();\r\n\r\n// Extract the first user's ID\r\nconst userId = users[0].id;\r\n\r\n// Store the ID as a collection variable\r\npm.collectionVariables.set(\"userId\", userId);\r\n\r\n// Validate that the ID was extracted and stored\r\npm.test(\"User ID is extracted and stored\", function () {\r\n    pm.expect(userId).to.exist;\r\n    pm.expect(userId).to.be.a(\"number\");\r\n});"
            ]
          }
        }
      ],
